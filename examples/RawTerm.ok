struct Termios {
    _iflag: u32,
    oflag: u32,
    _cflag: u32,
    lflag: u32,
    _line: u8,
    cc: [32]u8,
    _ispeed: u32,
    _ospeed: u32,
}

extern fn tcgetattr(fd: i32, termios: &mut Termios) void;
extern fn tcsetattr(fd: i32, action: i32, termios: &Termios) void;
extern fn read(fd: i32, ptr: &mut u8, len: u64) void;
extern fn write(fd: i32, ptr: &u8, len: u64) void;

fn main() i32 {
    let mut termios: Termios = undefined;
    let stdin = 0;
    tcgetattr(stdin, &termios);
    let oldTermios = termios;
    let echo = 8;
    let icanon = 2;
    termios.lflag &= ~(echo | icanon);
    let opost = 1;
    termios.oflag &= ~(opost);
    let vtime = 5;
    termios.cc[vtime] = 1;
    let vmin = 6;
    termios.cc[vmin] = 0;
    let flush = 2;
    tcsetattr(stdin, flush, &termios);
    putStr("\x1b[2J    six seven");
    while (true) {
        let mut input = 0;
        read(stdin, &input, 1);
        if (input == 'q') {
            break;
        }
    }
    tcsetattr(stdin, flush, &oldTermios);

    return 0;
}

fn putStr(str: []u8) void {
    let stdout = 1;
    write(stdout, str.ptr, str.len);
}
