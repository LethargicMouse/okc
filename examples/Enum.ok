extern fn write(fd: i32, ptr: &u8, len: u64) void;

type Color {
    red,
    yellow,
    green,
}

fn main() i32 {
    let color: Color = Color.green;
    switch (color) {
        case Color.red, Color.yellow {
            put_str("wait\n");
        }
        case Color.green {
            put_str("go\n");
        }
    }
    return 0;
}

fn put_str(s: []u8) void {
    write(1, s.ptr, s.len);
}
