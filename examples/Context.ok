extern fn exit(code: i32) !;
extern fn printf(fmt: [*]u8, s: [*]u8) void;

fn main() i32 {
    launch_rockets() ctx {
        log_level = .info,
        exit_callback = exit,
        pacifism = true,
    };
}

type Log_Level { no_logs, error, warn, info, debug }

fn launch_rockets() ctx {
    pacifism: bool,
    log_level: Log_Level,
    exit_callback: fn(i32) !,
} ! {
    if (pacifism) {
        log_fatal("can't launch rockets cuz I'm not evil");
    }
    unreachable;
}

fn log_fatal(msg: []u8) ctx {
    log_level: Log_Level,
    exit_callback: fn(i32) !
} ! {
    if (log_level < .error) {
        exit_callback(1);
    }
    printf("fatal: %s".ptr, msg.ptr);
    exit_callback(1);
}
