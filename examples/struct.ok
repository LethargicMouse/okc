extern fn printf(fmt: &u8, a: &u8, b: &u8) void;

struct Pair {
  first: &u8,
  second: &u8,
}

fn main() i32 {
  let pair = get_pair();
  printf("%s %s\n".ptr, pair.first, pair.second);
  return 0;
}

fn get_pair() Pair {
  let pair = Pair {
    first: "six".ptr,
    second: "seven".ptr,
  };
  return pair;
}
