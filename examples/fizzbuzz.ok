extern fn printf(fmt: &u8, n: i32) void;
extern fn puts(s: &u8) void;

fn main() i32 {
  let i = 0;
  while (i < 20) {
    i = i + 1;
    if (i % 15 == 0) {
      puts("fizzbuzz".ptr);
    } or (i % 5 == 0) {
      puts("buzz".ptr);
    } or (i % 3 == 0) {
      puts("fizz".ptr);
    } or {
      printf("%d\n".ptr, i);
    }
  }
  return 0;
}
