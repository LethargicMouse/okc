struct termios {
  iflag: u32,
  oflag: u32,
  cflag: u32,
  lflag: u32,
  line: u8,
  cc: [32]u8,
  ispeed: u32,
  ospeed: u32,
}

extern fn tcgetattr(fd: i32, termios: &mut termios) void;
extern fn tcsetattr(fd: i32, action: i32, termios: &termios) void;
extern fn read(fd: i32, ptr: &mut u8, len: u64) void;
extern fn write(fd: i32, ptr: &u8, len: u64) void;

fn main() i32 {
  let mut termios = undefined;
  let stdin = 0;
  tcgetattr(stdin, &mut termios);
  let termios_before = termios;
  let echo = 8;
  let icanon = 2;
  termios.lflag &= ~(echo | icanon);
  let opost = 1;
  termios.oflag &= ~(opost);
  let vtime = 5;
  termios.cc[vtime] = 1;
  let vmin = 6;
  termios.cc[vmin] = 0;
  let flush = 2;
  tcsetattr(stdin, flush, &termios);
  put_str("\x1b[2J    six seven");
  while (true) {
    let mut input: u8 = 0;
    read(stdin, &mut input, 1);
    if (input == 'q') {
      break;
    }
  }
  tcsetattr(stdin, flush, &termios_before);

  return 0;
}

fn put_str(str: str) void {
  let stdout = 1;
  write(stdout, str.ptr, str.len);
}
