struct termios {
  iflag: u32,
  oflag: u32,
  cflag: u32,
  lflag: u32,
  line: u8,
  cc: [32]u8,
  ispeed: u32,
  ospeed: u32,
}

extern fn tcgetattr(fd: i32, config: &mut termios) void;
extern fn tcsetattr(fd: i32, action: i32, config: &termios) void;
extern fn read(fd: i32, ptr: &mut u8, len: u64) void;
extern fn write(fd: i32, ptr: &u8, len: u64) void;

fn main() i32 {
  let mut config: termios = undefined;
  let stdin: i32 = 0;
  tcgetattr(stdin, &mut config);
  let old_config = config;
  let echo: u32 = 8;
  let icanon: u32 = 2;
  config.lflag &= ~(echo | icanon);
  let opost: u32 = 1;
  config.oflag &= ~(opost);
  let vtime: u8 = 5;
  config.cc[vtime] = 1;
  let vmin: u8 = 6;
  config.cc[vmin] = 0;
  let flush: i32 = 2;
  tcsetattr(stdin, flush, &config);
  put_str("\x1b[2J    six seven");
  while (true) {
    let mut input: u8 = 0;
    read(stdin, &mut input, 1);
    if (input == 'q') {
      break;
    }
  }
  tcsetattr(stdin, flush, &old_config);

  return 0;
}

fn put_str(str: []u8) void {
  let stdout: i32 = 1;
  write(stdout, str.ptr, str.len);
}
