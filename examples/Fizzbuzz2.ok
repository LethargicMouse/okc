extern fn write(fd: i32, ptr: &u8, size: u64) void;
extern fn printf(fmt: &u8, n: i32) void;
extern fn fflush(filePtrAsU64: u64) void;

fn main() i32 {
    while (i : 1..21) {
        let mut print_number = true;
        if (i % 3 == 0) {
            put_str("fizz");
            print_number = false;
        }
        if (i % 5 == 0) {
            put_str("buzz");
            print_number = false;
        }
        if (print_number) {
            put_i32(i);
        }
        put_str("\n");
    }
    return 0;
}

fn put_str(s: []u8) void {
    write(1, s.ptr, s.len);
}

fn put_i32(n: i32) void {
    printf("%d".ptr, n);
    fflush(0);
}
