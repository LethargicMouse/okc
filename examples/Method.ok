extern fn printf(fmt: &u8, a: &u8, b: &u8) void;

struct Cat {
    name: []u8,

    fn say(self: Self, phrase: []u8) void {
        printf("%s says %s\n".ptr, self.name.ptr, phrase.ptr);
    }
}

fn main() i32 {
    let cat = Cat {
        name = "kitkat",
    };
    cat.say("six");
    Cat.say(cat, "seven");
    return 0;
}
