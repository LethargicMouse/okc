extern fn write(fd: i32, ptr: &u8, len: u64) void;

type Color {
    red,
    yellow,
    green,
}

fn main() i32 {
    let color: Color = .green;
    let meaning = [
        .red, .yellow = "wait",
        .green = "go",
    ];
    put_str(meaning[color]);
    return 0;
}

fn put_str(s: []u8) void {
    write(1, s.ptr, s.len);
}
