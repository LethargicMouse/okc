extern fn printf(fmt: &u8, a: u8, b: u8) void;

struct Pair {
    first: u8,
    second: u8,
}

fn main() i32 {
    let pair = make_pair();
    printf(
        "%c-%c\n".ptr, 
        pair.first, 
        pair.second
    );
    return 0;
}

fn make_pair() Pair {
    return .{
        first = '6',
        second = '7',
    };
}
