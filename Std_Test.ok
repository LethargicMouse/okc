use Std;
use Std.Vec;
use Std.Args;

fn main(args: Args) i32 {
    // hello world
    Std.puts("hello world\n");

    // vec usage
    let mut vec = Vec.init();
    defer vec.deinit();
    vec.push("one");
    vec.push("two");
    vec.push("three");
    while (s : vec.data) {
        Std.puts(s);
        Std.puts(" ");
    }

    // args usage
    Std.putsln(args.get(0));

    return 0;
}
