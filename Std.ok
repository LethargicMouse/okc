use Std.C;

pub fn realloc<T>(ptr: [*]mut T, new_cap: u64) [*]mut T {
    return C.realloc(ptr, new_cap * #size<T>);
}

pub fn free<T>(ptr: [*]mut T) void {
    C.free(ptr);
}

pub fn print(s: []u8) void {
    let mut written = 0;
    while (written < s.len) {
        written += C.write(1, s.ptr, s.len);
    }
}
