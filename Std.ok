use Std.C;

pub fn realloc<T>(ptr: [*]mut T, new_cap: u64) [*]mut T {
    return C.realloc(ptr, new_cap * #size<T>);
}

pub fn free<T>(ptr: [*]mut T) void {
    C.free(ptr);
}

pub fn puts(s: []u8) void {
    let mut written = 0;
    while (written < s.len) {
        written += C.write(1, s.ptr, s.len);
    }
}

pub fn putsln(s: []u8) void {
    puts(s);
    puts("\n");
}

pub fn measure_cstr(ptr: [*]u8) []u8 {
    return .{ ptr = ptr, len = C.strlen(ptr) };
}
