type Self<T> {
    data: []mut T,
    cap: u64,
}

fn init() Self<T> {
    return .{
        data = &[],
        cap = 0,
    };
}

fn push(self: Self<T>, val: T) void {
    if (self.data.len == self.cap) {
        self.grow();
    }
    self.data.len += 1;
    self.data[self.data.len - 1] = val;
}
